[Unit]
Description=eMMC Studio web interface
After=network.target emmc-worker.service
Requires=emmc-worker.service
[Service]
Type=simple
User=emmc-web
Group=emmc-web
WorkingDirectory=/opt/emmc-studio/backend
ExecStart=/usr/bin/python3 /opt/emmc-studio/backend/web.py
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/emmc-web
StateDirectory=emmc-web
StateDirectoryMode=0750
UMask=0027
[Install]
WantedBy=multi-user.target
