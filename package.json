{
  "name": "emmc-studio",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "python -m unittest discover -s tests -p test_core.py",
    "test:frontend": "node scripts/test_frontend.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"public/*.js\" \"*.{json,html,ts,md}\" \"scripts/*.mjs\" \"tests/*.mjs\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"public/*.js\" \"*.{json,html,ts,md}\" \"scripts/*.mjs\" \"tests/*.mjs\" \"docs/**/*.md\""
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
